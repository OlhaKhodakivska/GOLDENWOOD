# Default: validate only; do not deliver requests.
INQUIRY_MODE=demo
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_INDEXABLE=false
# Required only in live mode. Configure secrets in your hosting environment.
INQUIRY_WEBHOOK_URL=
INQUIRY_WEBHOOK_TOKEN=
# Upstash-compatible REST Redis endpoint and token for distributed limits.
RATE_LIMIT_REDIS_URL=
RATE_LIMIT_REDIS_TOKEN=

# Enable only behind Cloudflare, which overwrites CF-Connecting-IP.
RATE_LIMIT_TRUST_CF_IP=false
